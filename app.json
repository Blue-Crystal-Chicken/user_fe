{
  "expo": {
    "name": "blue_crystall_chicken",
    "slug": "blue_crystall_chicken",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_bcc.jpg",
    "scheme": "blue_crystall_chicken",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo_bcc.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo_bcc.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.giuseppe_tesse.blue_crystall_chicken"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo_bcc.jpg"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo_bcc.jpg",
          "color": "#0a0f1c",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e0039db6-9419-4a56-bac6-473c15f4c742"
      }
    }
  }
}
